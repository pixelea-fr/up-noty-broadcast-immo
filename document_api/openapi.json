                "nullable": true
              },
              "date_disponibilite": {
                "type": "string",
                "format": "date",
                "nullable": true
              }
            },
            "required": [
              "loyer",
              "loyer_periodicite",
              "charges_incluses"
            ]
          }
        ]
      },
