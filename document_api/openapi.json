              },
              "honoraires_pourcentage": {
                "type": "number",
                "nullable": true,
                "description": "Pourcentage des honoraires de la vente"
              },
              "charges_copropriete": {
                "type": "number",
                "nullable": true
              },
              "rente": {
                "$ref": "#/components/schemas/rente"
              },
              "frais_acte": {
                "type": "number",
                "nullable": true
              },
              "prix": {
                "type": "number",
                "deprecated": true,
