                "description": "Cette valeur doit être un multiple de 500.",
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true,
                "multipleOf": 500
              },
              "date_fin": {
                "type": "string",
                "format": "date-time"
              },
              "frais_acte": {
                "type": "number",
                "nullable": true
              },
              "frais_pub": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true,
                "nullable": true,
                "deprecated": true
              }
            },
            "required": [
              "systeme_encheres",
              "premiere_offre",
              "pas_offre",
              "date_fin"
            ]
          }
        ]
      },
